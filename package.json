{
  "name": "electron-next-demo",
  "version": "1.2.0",
  "description": "A visual DuckDB client built with Electron and Next.js",
  "author": "Your Name or Company",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run next\" \"npm run electron\"",
    "next": "next dev",
    "electron": "wait-on http://localhost:3000 && electron .",
    "build": "next build",
    "start": "next start",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.16.1",
    "@duckdb/node-api": "^1.2.2-alpha.18",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "chart.js": "^4.4.9",
    "framer-motion": "^12.9.2",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "concurrently": "^8.0.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.example.visualduck",
    "productName": "VisualDuck",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
